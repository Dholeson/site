# Cloudflare Web Analytics is turned on for the Pages project, and Cloudflare
# injects its beacon into every HTML page on the production domain: a script
# from https://static.cloudflareinsights.com (script-src). It reports to
# /cdn-cgi/rum on this same domain, which connect-src 'self' already allows.
# That script host is the only non-'self' source in the global policy; every
# rule below restates it.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), camera=(), microphone=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'

# CSP exceptions -- one per vendored app whose images come from a CDN. Each is
# the policy above plus that one CDN, nothing else. Matching rules stack, and a
# header set twice is comma-joined -- the browser would then enforce both
# policies and block the images. "! " detaches the global value first; it only
# removes what earlier rules added, so these blocks must stay below /*.

# The Discover Cleaner demo (vendored from the app's repo by
# `npm run sync:discover-cleaner`) shows album covers, which load from
# Spotify's image CDN: https://i.scdn.co in img-src.
/projects/discover-cleaner-demo/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://i.scdn.co; font-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'

# league-ify (vendored from Dholeson/league-ify by its scripts/build-site.mjs)
# shows champion, item and spell art from Riot's Data Dragon CDN, and fetches
# Data Dragon's versions.json to pick the art version: the CDN in img-src and
# connect-src. test/league-ify.test.js checks this rule.
/projects/league-ify/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://ddragon.leagueoflegends.com; font-src 'self'; connect-src 'self' https://ddragon.leagueoflegends.com; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'

# Hashed-by-content assets could be cached harder, but nothing here is
# fingerprinted yet, so keep it short and let the CDN revalidate. The two
# longer rules below also match /assets/*, so each detaches its value first,
# as the CSP exceptions do; otherwise the two values are comma-joined and a
# cache keeps the first, 600 s.
/assets/*
  Cache-Control: public, max-age=600, must-revalidate

/assets/store/*
  ! Cache-Control
  Cache-Control: public, max-age=86400, must-revalidate

/assets/brand/*
  ! Cache-Control
  Cache-Control: public, max-age=604800, must-revalidate

# Never cache anything static under /api/. Note that _headers rules don't
# reach responses from Pages Functions (every /api/ endpoint is one): each
# Function sets its own Cache-Control, e.g. /api/store/img/* is immutable.
/api/*
  Cache-Control: no-store

# Keep the *.pages.dev copies of the site out of search results: the
# production one (dhole-dev.pages.dev) and every branch preview. Only
# dhole.dev should rank. Functions set the same header themselves on
# *.pages.dev (lib/seo.js isPagesDev), since _headers doesn't reach them.
https://:project.pages.dev/*
  X-Robots-Tag: noindex

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex
