/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), camera=(), microphone=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'

# The one CSP exception: the Discover Cleaner demo (vendored from the app's
# repo by `npm run sync:discover-cleaner`) shows album covers, which load from
# Spotify's image CDN. Same policy as above plus https://i.scdn.co in img-src.
# Matching rules stack, and a header set twice is comma-joined -- the browser
# would then enforce both policies and block the covers. "! " detaches the
# global value first; it only removes what earlier rules added, so this block
# must stay below /*.
/projects/discover-cleaner-demo/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://i.scdn.co; font-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'

# Hashed-by-content assets could be cached harder, but nothing here is
# fingerprinted yet, so keep it short and let the CDN revalidate.
/assets/*
  Cache-Control: public, max-age=600, must-revalidate

/assets/store/*
  Cache-Control: public, max-age=86400, must-revalidate

/assets/brand/*
  Cache-Control: public, max-age=604800, must-revalidate

# Never cache the checkout endpoint.
/api/*
  Cache-Control: no-store
