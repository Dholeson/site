# /etc/bench-ops.env
BENCH_DATA_DIR=/var/lib/bench-ops
BENCH_HOST=0.0.0.0
BENCH_PORT=80

# Interface facing the bench LAN. Unset = network watcher off (everything
# else still works; identification is advisory).
BENCH_WATCH_IFACE=eth0

# Only for a scanner plugged into the Pi itself. A scanner paired with the
# tech's phone/tablet needs nothing -- it types into the barcode field.
#BENCH_SCANNER_DEVICE=/dev/input/by-id/usb-YOUR_SCANNER-event-kbd
